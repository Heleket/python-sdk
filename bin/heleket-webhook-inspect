#!/usr/bin/env python3
"""Shim for `make webhook-inspect` and ad-hoc invocations.

If the package is installed (``pip install -e .``), prefer the
``heleket-webhook-inspect`` console script registered in ``pyproject.toml``.
"""

from __future__ import annotations

import sys
from pathlib import Path

# Make ``src/`` importable when running from a fresh checkout without `pip install -e .`.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from heleket_sdk._cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
