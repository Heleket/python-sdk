# Copy this file to .env and fill in your Heleket credentials.
# See https://doc.heleket.hk/general/getting-api-keys for how to obtain them.

# Merchant UUID — found in dash.heleket.hk → Settings.
HELEKET_MERCHANT_ID=

# Payment API key — used for /v1/payment/* endpoints and payment webhooks.
HELEKET_PAYMENT_KEY=

# Payout API key — used for /v1/payout/* endpoints and payout webhooks.
HELEKET_PAYOUT_KEY=

# Set to 1 to dump every HTTP request/response to stderr.
HELEKET_DEBUG=0

# Optional override of the API base URL (defaults to https://api.heleket.hk).
# HELEKET_BASE_URL=https://api.heleket.hk

# Optional: API domain (requests go to https://api.<domain>); ignored if HELEKET_BASE_URL is set.
# HELEKET_DOMAIN=heleket.hk

# Used by examples/05_handle_webhook.py and the handle_webhook docker service.
# HELEKET_WEBHOOK_URL=https://your.domain/heleket-webhook
